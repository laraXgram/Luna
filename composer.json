{
    "name": "laraxgram/luna",
    "type": "library",
    "description": "Integrates Luna.js with LaraGram for building server-driven Telegram Mini Apps.",
    "keywords": [
        "laragram",
        "luna",
        "tma",
        "inertia"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "LaraGram\\Luna\\": "src"
        },
        "files": [
            "./helpers.php"
        ]
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-sodium": "*",
        "laraxgram/core": "^4.5"
    },
    "suggest": {
        "ext-pcntl": "Recommended when running the Luna SSR server via the `luna:start-ssr` commander command."
    },
    "extra": {
        "laragram": {
            "providers": [
                "LaraGram\\Luna\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
